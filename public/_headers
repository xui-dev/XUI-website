# Static Chunks & Build Assets
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Robot Animation Frames — Permanent Edge & Browser Caching (Zero Cloudflare Origin Invocations)
/frame/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/laser/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/hide_robot/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
